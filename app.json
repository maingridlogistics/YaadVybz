{
  "expo": {
    "name": "Vybz Hub",
    "slug": "vybz-hub",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "vybzhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.chambex.vybzhub",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chambex.vybzhub",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCG0p2km3OUFNmGb2vSW-1aPyhZVJBGUJI"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "edgeToEdgeEnabled": true,
      "allowBackup": false,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Vybz Hub to use Face ID to securely sign you in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFD700",
          "defaultChannel": "vybzhub",
          "androidMode": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vybz Hub needs access to your photos so you can select event flyers and profile images to upload.",
          "cameraPermission": "Allow Vybz Hub to use your camera so you can take photos for event flyers and your profile.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Vybz Hub needs your camera to scan ticket QR codes at event entry. The camera is used only when you open the ticket scanner.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn com.stripe.android.pushProvisioning.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supportEmail": "info@vybzhub.com",
      "supportUrl": "mailto:info@vybzhub.com",
      "eas": {
        "projectId": "cfaf2242-dff0-4f25-87e6-97018b790e22"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
